# =============================================================================
# Test Environment Variables
# Copy this file to .env.test.local and fill in real values.
# .env.test.local is gitignored — never commit real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Google Integration
# Pre-obtained Google OAuth access token for integration tests.
# Obtain via: https://developers.google.com/oauthplayground
# Scopes needed: calendar.readonly, drive.readonly, docs.readonly, spreadsheets
# -----------------------------------------------------------------------------
TEST_GOOGLE_ACCESS_TOKEN=

# Title of a real Calendar event that has an exact-match Gemini Notes Doc in Drive.
# The Doc title should match the event title exactly (or near-exactly after normalization).
TEST_CALENDAR_EVENT_TITLE=

# Title matching multiple Drive Docs (for ambiguous match / tiebreaker test).
# Set this to a meeting title that appears in several Docs in Drive.
TEST_CALENDAR_AMBIGUOUS_TITLE=

# Title that matches no Drive Doc at all (for no-match fallback test).
TEST_CALENDAR_NO_MATCH_TITLE=

# Drive file ID of a real Gemini Notes Doc that contains a "# 📖 Transcript" heading.
# The content below that heading will be used as a real transcript for AI tests.
TEST_DOC_ID_WITH_TRANSCRIPT=

# Drive file ID of any Google Doc that does NOT contain the "# 📖 Transcript" heading.
TEST_DOC_ID_NO_TRANSCRIPT=

# Meeting title to pass to generateSummary in AI generation tests.
TEST_MEETING_TITLE=

# ISO 8601 date for AI generation tests, e.g. 2026-03-04
TEST_MEETING_DATE=

# -----------------------------------------------------------------------------
# Slack Integration
# Use a dedicated test Slack channel — never the live project channel.
# -----------------------------------------------------------------------------

# Channel ID of the dedicated test Slack channel (e.g. C0123456789)
TEST_SLACK_CHANNEL_ID=

# thread_ts of an existing top-level message in the test channel.
# Used to verify thread-reply posting. Format: "1234567890.123456"
TEST_SLACK_THREAD_TS=

# -----------------------------------------------------------------------------
# Notion Integration
# Use a dedicated test Notion database pre-configured with the correct schema.
# -----------------------------------------------------------------------------

# ID of the dedicated test Notion database (32-char UUID without hyphens)
TEST_NOTION_DATABASE_ID=

# -----------------------------------------------------------------------------
# Google Sheets Integration
# Use a dedicated test Google Sheet pre-configured with correct column headers.
# Column order must be: Category | Description | Owner | Due Date | Meeting | Meeting Date
# -----------------------------------------------------------------------------

# Spreadsheet ID from the Sheet URL (between /d/ and /edit)
TEST_GOOGLE_SHEETS_SPREADSHEET_ID=

# -----------------------------------------------------------------------------
# E2E / Playwright
# -----------------------------------------------------------------------------

# Full URL of the running Next.js app for E2E tests. Default: http://localhost:3000
TEST_APP_URL=http://localhost:3000

# Google account email for Playwright OAuth automation (E2E only).
# Use a dedicated test Google account, not a personal account.
TEST_GOOGLE_EMAIL=

# Google account password for Playwright OAuth automation (E2E only).
# Note: Google OAuth automation is fragile — 2FA or consent screens may require
# manual auth-state generation. See tests/e2e/global-setup.ts for details.
TEST_GOOGLE_PASSWORD=

# Supabase row ID (UUID) of a pre-configured project record with Notion destination.
# The project must already exist in the test Supabase database.
TEST_NOTION_PROJECT_ID=

# Supabase row ID (UUID) of a pre-configured project record with Sheets destination.
TEST_SHEETS_PROJECT_ID=

# -----------------------------------------------------------------------------
# Runtime vars — must also be set in the test environment
# These are the same vars used in production; provide test-specific values here.
# -----------------------------------------------------------------------------

# AI provider to use: "anthropic" or "gemini"
AI_PROVIDER=

# Anthropic API key (required when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Google AI Studio API key (required when AI_PROVIDER=gemini)
GOOGLE_AI_STUDIO_API_KEY=

# Slack bot token (xoxb-...)
SLACK_BOT_TOKEN=

# Notion integration token (secret_...)
NOTION_API_KEY=

# NextAuth secret (any long random string for test env)
NEXTAUTH_SECRET=

# NextAuth URL (should match TEST_APP_URL)
NEXTAUTH_URL=http://localhost:3000

# Google OAuth app credentials (can reuse dev credentials for test)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase project URL and keys — use a DEDICATED TEST Supabase project,
# not the production project. Schema must mirror production exactly.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
